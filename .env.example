# Kopieren nach .env und anpassen.

# Version des Docker-Images (z. B. 0.4.0), leer = latest
CLASSROOM_VERSION=

# Port, unter dem die App erreichbar ist (lokal und auf dem Host bei Docker)
PORT=3000

# Pfad der SQLite-Datenbank (wird bei Docker im Container auf /app/data gesetzt)
DATABASE_PATH=data/classroom.db

# Erstes Lehrerkonto – ist immer Admin. Wird beim Start angelegt bzw. sein Passwort auf diesen Wert gesetzt
# (so kommt man nach einem vergessenen Passwort wieder hinein).
# Weitere Lehrkräfte legt der Admin im Menü unter „Lehrkräfte“ an und hakt ihre Klassen an. Jede Lehrkraft sieht nur
# ihre Klassen und deren Schüler und hat ihren eigenen Auftrag, Ziele, Stunde und Wochenplan.
TEACHER_USERNAME=lehrer
# Unbedingt setzen (mind. 8 Zeichen)!
TEACHER_PASSWORD=

# Wie lange eine Anmeldung gültig bleibt (Stunden)
SESSION_HOURS=12

# Startwerte für die Stunde – gelten für jede Lehrkraft, bis sie im Menü eigene speichert
# Nach der Stunde Raumwechsel? true = „Zurück in <Raum> um …“, false = nur „Ende …“
DEFAULT_ROOM_CHANGE=true
# Raum, in den es danach zurückgeht
DEFAULT_ROOM_NAME=Klassenzimmer
# Beginn der Stunde (HH:MM), leer = nicht gesetzt
DEFAULT_START_TIME=
# Ende der Stunde (HH:MM), leer = nicht gesetzt
DEFAULT_RETURN_TIME=

# Dauer der Stunde in Minuten für „Stunde starten“: die erste gilt im Kopfband, wenn heute nichts mehr im
# Wochenplan steht; alle erscheinen im Menü zur Auswahl
LESSON_DURATIONS=45,90

# Zeitbalken: ab so vielen Minuten vor dem Ende „Aufräumen“ (orange) …
WARN_MINUTES=5
# … und ab so vielen Minuten „Jetzt zurück in …“ (groß, kräftig orange, Kopfband pulsiert)
GO_MINUTES=3

# Standard-Darstellung: system (folgt dem Betriebssystem), light oder dark.
# Jeder kann im Menü bzw. oben links selbst umschalten (wird pro Gerät gespeichert).
DEFAULT_THEME=system

# Stundenziele/Selbstlernen: Kacheln standardmäßig eingeklappt (nur Name + Fortschritt).
# „Alle aufklappen“ auf der Seite überschreibt das pro Gerät.
GOALS_COLLAPSED=true

# Lautstärke-Ampel links neben der Uhr (misst auf dem Lehrer-Gerät, Schüler sehen die Farbe).
# Startwerte – jede Lehrkraft kann sie im Menü unter „Anzeige → Ampel“ für sich ändern.
NOISE_ENABLED=true
# Empfindlichkeit 1–10 (höher = reagiert schon auf leisere Geräusche)
NOISE_SENSITIVITY=5
# Pegel 0–100, ab dem die Ampel gelb bzw. rot wird
NOISE_YELLOW=50
NOISE_RED=75

# Maximale Größe eines Bildes im Auftrag (MB)
UPLOAD_MAX_MB=5

# Auftrag teilen (QR-Code, ohne Anmeldung, nur lesen): Adresse, unter der Handys classRoom erreichen,
# z. B. http://192.168.1.20:3000 oder https://classroom.meine-schule.ch. Leer = die Adresse, mit der die
# Lehrkraft classRoom gerade geöffnet hat (bei „localhost“ kommen Handys so nicht hin).
PUBLIC_URL=
# Wie lange ein geteilter Auftrag standardmäßig gültig ist (Tage); beim Teilen auch 1, 7 oder 30 wählbar
SHARE_DAYS=7
